# ──────────────────────────────────────────────────────────────────────────────
# Kitchen LingLing Treasures — Environment Variables
# Copy this file to .env.local and fill in all values before running locally.
# NEVER commit .env.local or any file containing real secrets to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PayloadCMS ────────────────────────────────────────────────────────────────
# A random string used to sign PayloadCMS session tokens.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_HERE

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── App URL ───────────────────────────────────────────────────────────────────
# Used to construct gateway callback and return URLs.
# Local dev: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payment Gateway ───────────────────────────────────────────────────────────
# Set to either "toyyibpay" or "billplz" (lowercase, no quotes)
PAYMENT_GATEWAY=toyyibpay

# A secret token used to verify incoming webhook signatures.
# Generate one with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ── ToyyibPay (fill in only if PAYMENT_GATEWAY=toyyibpay) ────────────────────
# Your ToyyibPay user secret key (from your ToyyibPay dashboard)
TOYYIBPAY_API_KEY=YOUR_TOYYIBPAY_USER_SECRET_KEY

# The category code for this merchant's bill category
TOYYIBPAY_CATEGORY_CODE=YOUR_TOYYIBPAY_CATEGORY_CODE

# API base URL — use sandbox for testing
# Sandbox: https://dev.toyyibpay.com
# Production: https://toyyibpay.com
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

# ── Billplz (fill in only if PAYMENT_GATEWAY=billplz) ────────────────────────
# Your Billplz API key (from Settings > API)
BILLPLZ_API_KEY=YOUR_BILLPLZ_API_KEY

# The collection ID bills will be created under
BILLPLZ_COLLECTION_ID=YOUR_BILLPLZ_COLLECTION_ID

# API base URL — use sandbox for testing
# Sandbox: https://www.billplz-sandbox.com/api/v3
# Production: https://www.billplz.com/api/v3
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3

# ── Emails (Plunk Configuration) ──────────────────────────────────────────────
# Your Plunk API Key (from https://useplunk.com)
# Leave blank or omit in local dev to run in mock mode (email logs to console)
PLUNK_API_KEY=YOUR_PLUNK_API_KEY_HERE

# The email address that receives admin notifications for new pre-orders
ADMIN_EMAIL=admin@linglingkitchen.com

